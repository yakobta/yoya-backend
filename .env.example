# =====================================================
# NODE ENVIRONMENT
# =====================================================
NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=debug

# =====================================================
# DATABASE
# =====================================================
MONGODB_URI=mongodb://localhost:27017/yoya
MONGODB_URI_PROD=mongodb+srv://user:password@cluster.mongodb.net/yoya

# =====================================================
# REDIS
# =====================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# =====================================================
# JWT SECRETS
# =====================================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# =====================================================
# SECURITY & CORS
# =====================================================
CORS_ORIGIN=http://localhost:8000,http://localhost:3000
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# AI SERVICES
# =====================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_BASE_URL=https://api.heygen.com
OPENAI_API_KEY=your_openai_api_key
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# =====================================================
# STORAGE (Cloudinary)
# =====================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=yoya

# =====================================================
# EMAIL SERVICE (Nodemailer)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yoya.com
SMTP_FROM_NAME=Yoya Platform

# =====================================================
# PAYMENT (Stripe)
# =====================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_API_VERSION=2023-10-16

# =====================================================
# SMS SERVICE (Twilio)
# =====================================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# FIREBASE (Push Notifications)
# =====================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# =====================================================
# AWS (Optional S3 Storage)
# =====================================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=yoya-storage

# =====================================================
# ERROR TRACKING (Sentry)
# =====================================================
SENTRY_DSN=https://your_sentry_dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =====================================================
# APP SETTINGS
# =====================================================
APP_NAME=Yoya
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8000
BACKUP_URL=http://localhost:3001

# =====================================================
# FEATURE FLAGS
# =====================================================
FEATURE_VOICE_CLONING=true
FEATURE_AVATAR_GENERATION=true
FEATURE_VIDEO_SYNTHESIS=true
FEATURE_REAL_TIME_CALLS=true
FEATURE_TRANSLATION=true
FEATURE_PAYMENT=true
FEATURE_ANALYTICS=true

# =====================================================
# MONITORING
# =====================================================
PROMETHEUS_ENABLED=false
HEALTH_CHECK_INTERVAL=30000
METRICS_PORT=9090
